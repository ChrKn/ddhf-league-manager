APP_NAME=DDHF-Ranglistenverwaltung
APP_ENV=local
APP_KEY=
# On a server this is false, always. Laravel's error page shows the whole of this file when it is
# on - database password and mail password included - to anybody who can provoke an exception.
APP_DEBUG=true
# In production the full address with https and no trailing slash. The link in the password reset
# mail and every signed download route are built from it. `php artisan deploy:check` says so.
APP_URL=http://localhost

# Whether search engines may keep what they find. False sends X-Robots-Tag: noindex, nofollow with
# every response - which is the instruction that works, unlike a Disallow in robots.txt, since a
# crawler that is not let in never reads the noindex either. Set to false on a server that is
# finished but not announced.
# SITE_INDEXABLE=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# The scheduler, over HTTP. The server has no crontab, only a form in the hosting control panel
# that fetches a URL once a minute - so /cron is what drives the queue and the export prune.
#
# These two go into that form's "HTTP Benutzer" and "HTTP Passwort" fields and nowhere else.
# Anything long and random will do; nobody types them. Left blank the route answers 404 to
# everybody, which is what should happen on a machine that has no such form - this one included.
CRON_USER=
CRON_PASSWORD=

# Seconds the queue worker may run in one go. A crontab entry could give it the minute it has; a
# web request is cut off by the server long before that, so on a host without a crontab this wants
# to be comfortably under whatever that limit is.
# CRON_WORKER_SECONDS=20

# Which PHP the scheduled commands are started with. schedule:run does not run queue:work itself,
# it starts it as its own process - and outside the cli SAPI the finder ignores the running PHP and
# guesses, which on a host with several versions installed is the wrong one. The subprocess then
# dies unheard and schedule:run still reports success. php artisan deploy:check prints the path.
# CRON_PHP_BINARY=/usr/bin/php85

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Locally nothing is sent: mail lands in storage/logs. Anything else risks a password reset
# going to a real address while somebody is testing.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production: Google Workspace over Gmail's SMTP. Google is then the actual sender, so SPF and
# DKIM are already right for ddhf.de and there is nothing to add to the DNS. A message the web
# server posts itself lands in spam without them.
#
# MAIL_SCHEME stays empty. Laravel picks the scheme from the port - 465 means implicit TLS,
# anything else means STARTTLS, which is what 587 wants. "tls" is not a valid value here.
#
# MAIL_FROM_ADDRESS has to be the mailbox that authenticates, or an alias verified in Gmail under
# "send mail as". Otherwise Gmail rewrites the sender and the address in the message is not the
# one configured here.
#
# MAIL_PASSWORD is an app password (Account -> Security -> App passwords), sixteen characters, not
# the account password. It requires two-step verification on that mailbox.
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=
# MAIL_USERNAME=ranglisten@ddhf.de
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=ranglisten@ddhf.de
# MAIL_FROM_NAME="DDHF-Ranglisten"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
